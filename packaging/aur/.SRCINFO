pkgbase = kwal
	pkgdesc = KDE Plasma utility to manage the wallpaper and tint tools with palettes from the wallpaper
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/iguruspain/kwal
	arch = x86_64
	license = GPL3
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = ninja
	makedepends = pkgconf
	makedepends = git
	makedepends = patch
	makedepends = wayland-protocols
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = libglvnd
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-multimedia
	depends = qt6-webengine
	depends = qt6-imageformats
	depends = qt6-svg
	depends = qt6-multimedia-ffmpeg
	depends = kirigami
	depends = qqc2-desktop-style
	depends = kconfig
	depends = hicolor-icon-theme
	depends = wayland
	depends = ffmpeg
	depends = imagemagick
	optdepends = plasma-workspace: apply the wallpaper through org.kde.PlasmaShell (without it the app edits appletsrc directly)
	optdepends = plasma-integration: Plasma widget style, color scheme and native dialogs (only used when XDG_CURRENT_DESKTOP=KDE)
	optdepends = plasma6-wallpapers-smart-video-wallpaper-reborn: videos played in place (without it the cached first frame is applied as an image)
	optdepends = fastfetch: Fastfetch tab (hidden when the binary is not on PATH)
	optdepends = starship: Starship tab (hidden when the binary is not on PATH)
	optdepends = ulauncher: Ulauncher tab (hidden when the binary is not on PATH)
	source = git+https://github.com/iguruspain/kwal.git#tag=v0.1.0
	source = https://github.com/marzer/tomlplusplus/archive/refs/tags/v3.4.0.tar.gz
	source = https://github.com/material-foundation/material-color-utilities/archive/bd811e4ca2ab94c4ce3cadc89c19b1820b9704b3.tar.gz
	sha256sums = SKIP
	sha256sums = 8517f65938a4faae9ccf8ebb36631a38c1cadfb5efa85d9a72e15b9e97d25155
	sha256sums = 176330652129f9af18b864f0df2af8c4bbb9b3c68642d236bdd54a4daa5d9f78

pkgname = kwal
