# PKGBUILD for the kwal AUR package (kwal — source build; makepkg produces the
# binary). Publish it by pushing this directory to the AUR remote
# (ssh://aur@aur.archlinux.org/<pkgname>.git); scripts/release.sh <version> is
# what bumps pkgver and regenerates .SRCINFO with `makepkg --printsrcinfo`
# inside the release commit, so the two files stay in step with the tag.
#
# Publishing is automated by scripts/release.sh <version>: it sets pkgver from
# project(VERSION), cuts the annotated tag and regenerates .SRCINFO with
# `makepkg --printsrcinfo`. The source is the **tag** over git, not a GitHub
# archive URL: GitHub builds those archives on request and its gzip
# output is not fixed (in Feb 2023 a change mass-broke pinned archive hashes
# across AUR), so a sha256 of one is a time bomb — and an unsigned sum next to
# the file it hashes is theatre anyway. The pinned dependency hashes below are
# real content pins (they are build inputs) and are never touched by the
# script.
#
# Authenticity for the user: the source is an HTTPS clone of the project repo
# and the tag pins the exact commit. makepkg rejects a tag that points at
# another tag, but it does NOT notice a tag moved by a force-push — trust the
# repo you clone from, as with every other AUR git source.
#
# Packaging facts (verified against the project CMakeLists.txt):
# - Both pinned deps are fed offline via FETCHCONTENT_SOURCE_DIR_* +
#   FETCHCONTENT_FULLY_DISCONNECTED (the documented offline flow): the
#   system tomlplusplus is deliberately NOT used — find_package(tomlplusplus)
#   would skip FetchContent but the fully-disconnected configure then has
#   nothing to populate (verified: generate fails with "target
#   tomlplusplus::tomlplusplus not found"). The raw pinned tarballs are the
#   correct sources — the project CMake applies its own compile-fix patch to
#   a pristine mcu tree at configure time.
# - ffmpeg/ffprobe and magick are invoked as binaries (QStandardPaths), not
#   linked: full packages, not -libs.
# - libwayland-client is linked directly (transition overlay); the scanner
#   (wayland-scanner), the wayland-protocols XMLs (xdg-shell, viewporter,
#   xdg-output) and the vendored wlr-layer-shell XML cover the rest.
#   No qt6-wayland: the Wayland platform plugin (plugins/platforms/
#   libqwayland.so) ships inside qt6-base, and the project uses zero
#   QtWayland/QWayland symbols (verified with pacman -Qo and a source grep).
# - The configure hard-requires the 'patch' program (find_program in
#   CMakeLists.txt) to fix the pristine mcu tarball for GCC 16.
# - qt6-imageformats/qt6-svg/qt6-multimedia-ffmpeg are separate Arch packages
#   and nothing depends on them; without the image handlers QImageReader
#   reports "Unsupported image format" and webp/svg wallpapers silently read
#   as static with no palette; without the media backend MediaPlayer finds no
#   plugin and inline video/GIF playback is dead.
pkgname=kwal
pkgver=0.1.0
pkgrel=1
pkgdesc="KDE Plasma utility to manage the wallpaper and tint tools with palettes from the wallpaper"
arch=('x86_64')
url="https://github.com/iguruspain/kwal"
license=('GPL3')
depends=(
    glibc             # direct link deps (Arch guideline: declare what the
    libgcc            # binaries name in DT_NEEDED, even when another dep
    libstdc++         # already pulls them)
    libglvnd          # Qt Quick's OpenGL path (libGLX, libOpenGL)
    qt6-base          # Core Gui Widgets Network DBus Qml/Quick hosts, and the
                      # Wayland platform plugin (plugins/platforms/libqwayland.so)
    qt6-declarative   # QML module, QuickControls2, qmlcachegen
    qt6-multimedia    # inline video/GIF playback in the grid
    qt6-webengine     # Starship terminal preview
    qt6-imageformats  # WebP/TIFF/ICNS image handlers (libqwebp.so is not in qt6-base)
    qt6-svg           # SVG image handler (libqsvg.so) for svg wallpapers
    qt6-multimedia-ffmpeg # the actual media backend plugin
                          # (plugins/multimedia/libffmpegmediaplugin.so is owned
                          # by this package, NOT by qt6-multimedia: without it
                          # MediaPlayer has no backend and inline video/GIF
                          # playback in the grid silently fails)
    kirigami          # KF6 Kirigami + KirigamiPlatform
    qqc2-desktop-style # org.kde.desktop Controls style main.cpp selects on KDE
    kconfig           # kwalrc
    hicolor-icon-theme # install target of icons/hicolor/scalable/apps/kwal.svg
    wayland           # libwayland-client (transition overlay)
    ffmpeg            # ffmpeg/ffprobe binaries (frames, resizes)
    imagemagick       # magick binary (logo tinting)
)
makedepends=(
    cmake
    extra-cmake-modules
    ninja
    pkgconf
    git                # the source is a git tag (see the header)
    patch              # CMake find_program(patch) applies cmake/mcu-gcc16.patch
                       # to the pristine mcu tarball; configure FATAL_ERRORs
                       # without it (base-devel usually carries it, declared
                       # because the build hard-requires it)
    wayland-protocols  # transition overlay protocol XMLs (build only)
)
optdepends=(
    'plasma-workspace: apply the wallpaper through org.kde.PlasmaShell (without it the app edits appletsrc directly)'
    'plasma-integration: Plasma widget style, color scheme and native dialogs (only used when XDG_CURRENT_DESKTOP=KDE)'
    'plasma6-wallpapers-smart-video-wallpaper-reborn: videos played in place (without it the cached first frame is applied as an image)'
    'fastfetch: Fastfetch tab (hidden when the binary is not on PATH)'
    'starship: Starship tab (hidden when the binary is not on PATH)'
    'ulauncher: Ulauncher tab (hidden when the binary is not on PATH)'
)
# The tag over git, not a GitHub archive URL: those archives are
# generated on demand (their bytes are not ours to pin) and an unsigned sum
# next to the file it hashes proves nothing — see the header. makepkg clones
# the repo and checks out v${pkgver} into $srcdir/kwal.
source=(
    "git+https://github.com/iguruspain/kwal.git#tag=v${pkgver}"
    "https://github.com/marzer/tomlplusplus/archive/refs/tags/v3.4.0.tar.gz"
    "https://github.com/material-foundation/material-color-utilities/archive/bd811e4ca2ab94c4ce3cadc89c19b1820b9704b3.tar.gz"
)
sha256sums=(
    'SKIP'  # git clone of the pinned tag (see the header)
    '8517f65938a4faae9ccf8ebb36631a38c1cadfb5efa85d9a72e15b9e97d25155'
    '176330652129f9af18b864f0df2af8c4bbb9b3c68642d236bdd54a4daa5d9f78'
)

build() {
    cmake -B build -S kwal \
        -DCMAKE_BUILD_TYPE=Release \
        -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
        -DFETCHCONTENT_SOURCE_DIR_TOMLPLUSPLUS="$srcdir/tomlplusplus-3.4.0" \
        -DFETCHCONTENT_SOURCE_DIR_MCU="$srcdir/material-color-utilities-bd811e4ca2ab94c4ce3cadc89c19b1820b9704b3"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
